(ns app-otent.core
  "The browser entry point: one mount, one render loop.

  Everything here is glue. The scene is computed by
  `app-otent.globe.scene`, the propagation by `app-otent.propagate`, the
  state transitions by `app-otent.db` -- all pure and all tested. This
  file owns the canvas, the animation frame and the pointer, and nothing
  else.

  ## One document

  The nav is `<a href=\"#objects\">`; crossing a view changes state. The
  canvas and the GPU device are created once and survive every crossing,
  which is the point -- re-creating a WebGPU device per screen would make
  the globe blink on every click."
  (:require [kotoba.lang.text :as str]
            [reagent.dom.client :as rdc]
            [re-frame.core :as rf]
            [re-frame.db :as rf-db]
            [app-otent.db :as db]
            [app-otent.events :as events]
            [app-otent.subs :as subs]
            [app-otent.views :as views]
            [app-otent.route :as route]
            [app-otent.globe.renderer :as renderer]
            [app-otent.globe.scene :as scene]
            [app-otent.weather :as wx]))

(defonce ^{:doc "The GPU side, kept out of the re-frame db: a device, a
  texture cache and a set of buffers are not values, and putting them in
  app-db would make every `assoc` walk them."}
  gpu (atom {:state nil :tiles-at nil :lines-done? false
             :buildings-key nil :buildings-loading? false}))

(defonce root (atom nil))

(defonce ^{:doc "The weather view's arrays: decoded frames, the interpolated
  fields, the particles and the scratch vertex buffers. Beside `gpu` and
  out of app-db for the same reason -- typed arrays are not values."}
  wx-state (atom {:run nil :frames {} :cur nil :particles nil
                  :scratch nil :key nil :indices-for nil :rain-n 0
                  :extrema [] :last-ts nil :shown? false}))

(def ^:private particle-count 4000)
(def ^:private particle-trail 12)

(declare start-globe!)

(defn- diag!
  "Publish a small diagnostic on `window`.

  A render loop that has silently stopped and a render loop that is drawing
  nothing produce the same blank canvas. This is how a test tells them
  apart, and it is why `test/browser/smoke.mjs` can assert the loop is
  ALIVE rather than inferring it from pixels."
  [k v]
  (let [d (or (aget js/window "__otent") #js {})]
    (aset d (name k) v)
    (aset js/window "__otent" d)))

(defn- live-canvas
  "The canvas that is in the document RIGHT NOW.

  Asked every frame rather than captured once, because React 18's
  `createRoot(...).render(...)` is a client render, not a hydration: it
  discards the server-rendered children of `#app` and builds new ones. A
  renderer created before that commit holds a canvas that is still a
  perfectly good object -- it keeps its drawing buffer, it accepts draw
  calls, it reports 402x600 -- and is no longer in the page.

  Measured 2026-08-26: the frame counter climbed past 700, the diagnostic
  said `canvas 402x600`, and `document.querySelectorAll('canvas')` found
  exactly one canvas, unsized at 300x150, showing nothing. Nothing errored,
  because nothing was wrong: the GPU was drawing into a detached node."
  []
  (.getElementById js/document "otent-globe"))

(defn- tile-key [{:keys [z x y]}] (str z "/" x "/" y))

(defn- load-tile!
  "Fetch one basemap tile from OUR bucket, through the Worker, and hand the
  decoded bitmap to whichever backend is running.

  A 404 is left alone rather than retried: the tile was never ingested,
  and asking again every frame turns one hole into a request storm."
  [state coord]
  (-> (js/fetch (str "/api/basemap/blue-marble/" (:z coord) "/" (:x coord) "/" (:y coord) ".jpg"))
      (.then (fn [r] (when (.-ok r) (.blob r))))
      (.then (fn [b] (when b (js/createImageBitmap b))))
      ;; 32 segments for the coarsest two zooms, 8 above. At z0 one tile is
      ;; the whole planet, and 8 segments across it draw a visible polygon
      ;; for a limb -- plain under a raster alone, glaring once the
      ;; translucent weather shell curves smoothly around it.
      (.then (fn [img] (when img (renderer/ensure-tile! state coord img
                                                        (if (< (:z coord) 2) 32 8)))))
      (.catch (fn [_] nil))))

(defn- sync-tiles!
  "Bring the resident tile set in line with the camera."
  [state camera max-zoom]
  (let [z (scene/zoom-for-distance (:distance camera) max-zoom)
        want (scene/visible-tiles z camera)
        want-keys (set (map tile-key want))]
    (when (not= [z (:lat-deg camera) (:lon-deg camera)] (:tiles-at @gpu))
      (swap! gpu assoc :tiles-at [z (:lat-deg camera) (:lon-deg camera)])
      (renderer/drop-tiles! state want-keys)
      (doseq [c want] (load-tile! state c)))))

(defn- load-vector-lines!
  "Coastlines and borders, once, from the bucket."
  [state]
  (when-not (:lines-done? @gpu)
    (swap! gpu assoc :lines-done? true)
    (-> (js/Promise.all
         #js [(.then (js/fetch "/api/basemap/vector/coastline.json") #(.json %))
              (.then (js/fetch "/api/basemap/vector/borders.json") #(.json %))])
        (.then (fn [layers]
                 (let [lines (mapcat (fn [l] (js->clj (aget l "lines")))
                                     (array-seq layers))]
                   (renderer/set-lines! state (scene/line-vertices lines 0.0015)))))
        (.catch (fn [_] (swap! gpu assoc :lines-done? false))))))

(defn- sync-buildings!
  "Fetch and upload the building footprints for wherever the camera is.

  Keyed on the SET of tiles in view, so moving within one block does no
  work and leaving a covered area clears the mesh. Without the clear, the
  last city stays welded to the globe and rotates with it.

  Each tile is one R2 object the Worker serves; the MVT was decoded once
  at ingest, so nothing here parses protobuf."
  [state camera areas]
  (let [tiles (scene/building-tiles-in-view camera areas)
        k (str/join "," (map (fn [{:keys [z x y]}] (str z "/" x "/" y)) tiles))]
    (when (and (not (:buildings-loading? @gpu)) (not= k (:buildings-key @gpu)))
      (swap! gpu assoc :buildings-key k :buildings-loading? true)
      (if (empty? tiles)
        (do (renderer/set-buildings! state nil)
            (renderer/set-surface! state nil)
            ;; The diagnostic must be cleared HERE too. It was set only on
            ;; the load path, so flying out of a city cleared the mesh and
            ;; left `buildings: 7821` on `window.__otent` -- and the
            ;; browser test read that as the city still being drawn.
            ;; A stale instrument and a stale scene look identical.
            (diag! :buildings 0)
            (diag! :surface 0)
            (swap! gpu assoc :buildings-loading? false))
        (-> (js/Promise.all
             (clj->js (for [{:keys [z x y]} tiles]
                        (-> (js/fetch (str "/api/basemap/buildings/" z "/" x "/" y ".json"))
                            (.then (fn [r] (when (.-ok r) (.json r))))
                            (.catch (constantly nil))))))
            (.then (fn [results]
                     (let [ok (remove nil? (array-seq results))
                           records (mapcat #(js->clj (aget % "buildings") :keywordize-keys true) ok)
                           ground (mapcat #(js->clj (or (aget % "surface") #js [])
                                                    :keywordize-keys true) ok)
                           mesh (scene/buildings->mesh records)
                           ;; Lifted 1 m off the sphere. The raster tile is
                           ;; drawn at exactly radius 1, and coplanar
                           ;; surfaces z-fight into a shimmer that looks
                           ;; like a driver bug.
                           smesh (scene/surface->mesh ground (/ 1.0 6371000.0))]
                       (diag! :buildings (count records))
                       (diag! :surface (count ground))
                       (renderer/set-surface! state (when (seq (:indices smesh)) smesh))
                       (renderer/set-buildings! state (when (seq (:indices mesh)) mesh))
                       (swap! gpu assoc :buildings-loading? false))))
            (.catch (fn [_] (swap! gpu assoc :buildings-loading? false
                                   :buildings-key nil))))))))

(defn- rf-random [] (js/Math.random))

(defn- weather-key-path [key]
  ;; manifest keys are bucket paths; the Worker serves them under /api/weather/
  (subs key (count "otent/weather/")))

(defn- load-weather-frames!
  "Fetch and decode every frame of the manifest's run, nearest to the
  clock first, two at a time. Each arrival is reported to app-db so the
  clock -- which holds rather than interpolating through a frame it does
  not have -- can move."
  [manifest t]
  (let [run (:run manifest)
        frames (vec (:frames manifest))
        ts (wx/frame-times frames)
        order (vec (sort-by #(Math/abs (- (nth ts %) t)) (range (count frames))))
        queue (atom order)
        lane (fn lane []
               (when-let [i (first @queue)]
                 (swap! queue rest)
                 (-> (js/fetch (str "/api/weather/" (weather-key-path (:key (nth frames i)))))
                     (.then (fn [r] (if (.-ok r) (.arrayBuffer r) (throw (js/Error. (str "HTTP " (.-status r)))))))
                     (.then (fn [buf]
                              (when (= run (:run @wx-state))
                                (let [f (wx/decode-frame buf manifest)]
                                  (if (:refused f)
                                    (diag! :wxRefused (str i ":" (name (:refused f))))
                                    (do (swap! wx-state assoc-in [:frames i] (:fields f))
                                        (rf/dispatch [::events/weather-frame-loaded i])))))))
                     (.catch (fn [e] (diag! :wxError (str i ": " (.-message e)))))
                     (.then lane))))]
    (swap! wx-state assoc :run run :frames {} :cur nil :key nil)
    (lane) (lane)))

(defn- scratch!
  "Vertex arrays sized for the worst case, allocated once per grid."
  [{:keys [nlat nlon] :as grid}]
  (or (:scratch @wx-state)
      (let [cells (* nlat nlon)
            s {:shell (js/Float32Array. (* wx/shell-stride nlat (inc nlon)))
               :indices (wx/shell-indices grid)
               ;; rain: one segment per cell; particles: (trail-1) per particle
               :under (js/Float32Array. (* wx/line-stride 2 (+ cells (* particle-count particle-trail))))
               ;; isobars: generously, four segments per cell
               :over (js/Float32Array. (* wx/line-stride 2 4 cells))}]
        (swap! wx-state assoc :scratch s)
        s)))

(defn- ensure-cur! [fields-a]
  (or (:cur @wx-state)
      (let [c (into {} (map (fn [[id a]] [id (js/Float32Array. (.-length a))])) fields-a)]
        (swap! wx-state assoc :cur c)
        c)))

(def ^:private low-colour "rgb(255,110,110)")
(def ^:private high-colour "rgb(120,170,255)")

(defn- place-labels!
  "Position the 低/高 labels over their centres, hiding those behind the
  planet. A small pool of spans, reused; textContent is touched only when
  it changes."
  [state camera aspect exaggeration]
  (when-let [layer (.getElementById js/document "otent-wx-labels")]
    (let [{:keys [eye view-proj]} (scene/orbit-camera (assoc camera :aspect aspect))
          canvas (:canvas state)
          cw (.-clientWidth canvas) ch (.-clientHeight canvas)
          ex (:extrema @wx-state)]
      (while (< (.-childElementCount layer) (count ex))
        (let [el (.createElement js/document "span")]
          (set! (.-className el) "otent-wx-label")
          (.appendChild layer el)))
      (dotimes [k (.-childElementCount layer)]
        (let [el (aget (.-children layer) k)]
          (if-let [{:keys [kind lat lon hpa]} (get ex k)]
            (let [alt (+ 20.0 (wx/pressure->alt-km (* 100.0 hpa) exaggeration))
                  [nx ny vis?] (scene/project view-proj eye (scene/lat-lon->globe lat lon alt))
                  txt (str (if (= kind :low) "低" "高") " " (Math/round hpa))]
              (if-not vis?
                (set! (.. el -style -display) "none")
                (do (set! (.. el -style -display) "block")
                    (set! (.. el -style -left) (str (* cw (/ (inc nx) 2.0)) "px"))
                    (set! (.. el -style -top) (str (* ch (/ (- 1.0 ny) 2.0)) "px"))
                    (set! (.. el -style -color) (if (= kind :low) low-colour high-colour))
                    (when (not= txt (.-textContent el)) (set! (.-textContent el) txt)))))
            (set! (.. el -style -display) "none")))))))

(defn- clear-weather! [state]
  (when (:shown? @wx-state)
    (renderer/set-wx-mesh! state nil 0 nil)
    (renderer/set-wx-lines! state :under nil 0)
    (renderer/set-wx-lines! state :over nil 0)
    (when-let [layer (.getElementById js/document "otent-wx-labels")]
      (set! (.-innerHTML layer) ""))
    (swap! wx-state assoc :shown? false :key nil)))

(defn- weather-frame!
  "One frame of the weather view: advance the clock, interpolate the two
  frames around it, rebuild what changed, move the particles, upload."
  [state d camera aspect ts]
  (let [dt (min 100.0 (if-let [l (:last-ts @wx-state)] (- ts l) 16.0))
        _ (swap! wx-state assoc :last-ts ts)
        _ (rf/dispatch-sync [::events/weather-advance dt])
        d @rf-db/app-db
        {:keys [manifest t mode exaggeration show]} (:weather d)
        grid (:grid manifest)]
    (when (and manifest (not= (:run manifest) (:run @wx-state)))
      (load-weather-frames! manifest (or t (js/Date.now))))
    (when (and grid t)
      (let [times (wx/frame-times (:frames manifest))
            [i j w] (wx/bracket times t)
            fa (get-in @wx-state [:frames i])
            fb (get-in @wx-state [:frames j])]
        (when (and fa fb)
          (let [{:keys [shell indices under over]} (scratch! grid)
                cur (ensure-cur! fa)
                ;; w quantised to 1/50 of a step: the surface, isobars and
                ;; rain are rebuilt when the picture could visibly change,
                ;; not sixty times a second for a sub-pixel difference.
                k [i j (Math/round (* 50 w)) mode exaggeration (:isobars show) (:rain show)
                   (identical? state (:indices-for @wx-state))]]
            (when (not= k (:key @wx-state))
              (doseq [[id a] fa] (wx/lerp-into! (get cur id) a (get fb id) w))
              (wx/shell-vertices! shell grid cur mode exaggeration 0.42)
              (let [fresh? (not (identical? state (:indices-for @wx-state)))]
                (renderer/set-wx-mesh! state shell (* (:nlat grid) (inc (:nlon grid)))
                                       (when fresh? indices))
                (swap! wx-state assoc :indices-for state))
              (renderer/set-wx-lines!
               state :over over
               (if (:isobars show)
                 (wx/isobar-lines! over 0 (wx/isobar-segments grid (get cur "prmsl") 4.0) exaggeration)
                 0))
              (swap! wx-state assoc
                     :rain-n (if (:rain show) (wx/rain-lines! under 0 grid (get cur "prate") 0.5) 0)
                     :extrema (wx/extrema grid (get cur "prmsl") 3 24)
                     :key k :shown? true))
            ;; Particles every frame, whether or not the forecast plays: they
            ;; trace the wind of the instant on screen. Their clock scales with
            ;; the camera's height so they cross the screen at a readable
            ;; pace -- about 16 simulated hours per real second per earth
            ;; radius of altitude -- and the rate is stated on the page.
            (let [ps (or (:particles @wx-state)
                         (let [p (wx/make-particles particle-count particle-trail rf-random)]
                           (swap! wx-state assoc :particles p) p))
                  pdt (* (/ dt 1000.0) (wx/particle-hours-per-second camera) 3600.0)
                  _ (wx/advect! ps grid (get cur "u10") (get cur "v10") pdt rf-random)
                  ps (wx/record-trail! ps)
                  _ (swap! wx-state assoc :particles ps)
                  rain-n (:rain-n @wx-state)
                  pn (if (:wind show)
                       (wx/particle-lines! under rain-n ps grid (get cur "u10") (get cur "v10"))
                       0)]
              (renderer/set-wx-lines! state :under under (+ rain-n pn))
              (diag! :wxParticles pn))
            (place-labels! state camera aspect exaggeration)
            (diag! :wxFrame (str i "/" j))))))))

(defn- frame!
  "One frame.

  Reads `app-db` DIRECTLY rather than through `rf/subscribe`.

  A re-frame subscription deref'd outside a reactive context returns its
  cached value and does not necessarily recompute -- there is no reaction
  watching it, so nothing invalidates the cache. Measured: the plaque
  (rendered by reagent, in a reactive context) showed 7,214 aircraft while
  this loop received an empty vector and issued `Draw` with an instance
  count of 0, every frame, silently.

  Reading the atom and applying the same pure functions is also simply
  what this loop wants: `db/visible-objects` is a function of a map."
  [ts]
  (diag! :frames (inc (or (some-> (aget js/window "__otent") (aget "frames")) 0)))
  (let [{:keys [state]} @gpu]
    ;; If the node we hold is no longer the node in the page, rebuild on the
    ;; live one. Guarded by `:starting?`, so this cannot storm.
    ;; `start-globe!` is async and guarded, so this may fire on several
    ;; frames before the new state lands. It counts nothing -- the counter
    ;; is incremented where a rebuild actually BEGINS, or the number
    ;; measures how fast the loop runs rather than how often it rebuilt.
    (when (and state (not (identical? (live-canvas) (:canvas state))))
      (start-globe!))
    (when state
      (let [now (js/Date.now)]
        (rf/dispatch-sync [::events/advance now])
        (let [d @rf-db/app-db
              camera (:camera d)
              objects (db/visible-objects d)
              max-zoom (or (get-in d [:basemap :manifest :raster :max-zoom]) 2)
              {:keys [dpr aspect]} (renderer/resize! (:canvas state))]
          (diag! :canvas (str (.-width (:canvas state)) "x" (.-height (:canvas state))))
          (diag! :objects (count objects))
          (diag! :maxZoom max-zoom)
          (sync-tiles! state camera max-zoom)
          (sync-buildings! state camera (get-in d [:buildings :areas]))
          (load-vector-lines! state)
          (if (= :weather (:view d))
            (do (renderer/set-markers! state [])
                (weather-frame! state d camera aspect ts))
            (do (clear-weather! state)
                (renderer/set-markers! state (scene/marker-vertices objects))))
          (renderer/draw! state
                          {:view-proj (:view-proj (scene/orbit-camera
                                                   (assoc camera :aspect aspect)))
                           :dpr dpr})))))
  (js/requestAnimationFrame frame!))

(defn- probe!
  "The weather under the pointer, read off the interpolated fields."
  [canvas e]
  (let [d @rf-db/app-db]
    (when-let [cur (and (= :weather (:view d)) (:cur @wx-state))]
      (let [r (.getBoundingClientRect canvas)
            nx (- (* 2.0 (/ (- (.-clientX e) (.-left r)) (.-width r))) 1.0)
            ny (- 1.0 (* 2.0 (/ (- (.-clientY e) (.-top r)) (.-height r))))
            aspect (/ (.-width r) (max 1.0 (.-height r)))]
        (if-let [{:keys [lat-deg lon-deg]} (scene/pick (assoc (:camera d) :aspect aspect) nx ny)]
          (rf/dispatch [::events/weather-probe
                        (assoc (wx/readout (get-in d [:weather :manifest :grid]) cur lat-deg lon-deg)
                               :lat lat-deg :lon lon-deg)])
          (rf/dispatch [::events/weather-probe nil]))))))

(defn- attach-pointer! [canvas]
  (let [dragging (atom nil)]
    (.addEventListener canvas "pointerdown"
                       (fn [e] (reset! dragging [(.-clientX e) (.-clientY e)])
                         (.setPointerCapture canvas (.-pointerId e))))
    (.addEventListener canvas "pointerup" (fn [_] (reset! dragging nil)))
    (.addEventListener canvas "pointercancel" (fn [_] (reset! dragging nil)))
    (.addEventListener canvas "pointermove"
                       (fn [e]
                         (if-let [[x y] @dragging]
                           (do (rf/dispatch [::events/drag (- (.-clientX e) x) (- (.-clientY e) y)])
                               (reset! dragging [(.-clientX e) (.-clientY e)]))
                           (probe! canvas e))))
    (.addEventListener canvas "wheel"
                       (fn [e] (.preventDefault e)
                         (rf/dispatch [::events/zoom (.-deltaY e)]))
                       #js {:passive false})))

(defn start-globe!
  "Create the renderer on whatever canvas is currently in the page.

  Idempotent, and safe to call from anywhere: it does nothing if the
  renderer already holds the live canvas, and nothing if there is no canvas
  at all (the user is on another view -- not an error).

  Called from `mount!`, from the route listener, and from `frame!` when the
  node identity drifts."
  []
  (when-let [canvas (live-canvas)]
    (when-not (or (:starting? @gpu)
                  (identical? canvas (:canvas (:state @gpu))))
      ;; Set SYNCHRONOUSLY, and cleared only when the promise resolves.
      ;; Guarding on `:state` instead let two calls arriving in the same
      ;; tick -- which is exactly what `mount!` and the route listener do --
      ;; both see it empty and both build a renderer.
      (swap! gpu assoc :starting? true)
      (when (:state @gpu)
        (diag! :reattached
               (inc (or (some-> (aget js/window "__otent") (aget "reattached")) 0))))
      (renderer/resize! canvas)
      (-> (renderer/create canvas)
          (.then (fn [state]
                   ;; Tile and line caches belong to the OLD GPU context;
                   ;; on a re-attach they must not be treated as resident.
                   (swap! gpu assoc :state state :starting? false
                          :tiles-at nil :lines-done? false)
                   (diag! :backend (name (or (:backend state) :nil)))
                   (rf/dispatch [::events/set-backend (:backend state)])
                   (when (not= :none (:backend state))
                     (attach-pointer! canvas)
                     (js/requestAnimationFrame frame!))))
          (.catch (fn [e]
                    (diag! :startError (str (.-message e)))
                    (swap! gpu assoc :starting? false)))))))

(defn ui []
  [views/app (assoc @(rf/subscribe [::subs/page-model])
                    :on-fly #(rf/dispatch [::events/fly-to %])
                    :on-weather (fn [[k v]]
                                  (rf/dispatch
                                   (case k
                                     :play [::events/weather-toggle-play]
                                     :seek [::events/weather-seek v]
                                     :speed [::events/weather-speed v]
                                     :mode [::events/weather-mode v]
                                     :exaggeration [::events/weather-exaggeration v]
                                     :toggle [::events/weather-toggle v]
                                     :tilt [::events/set-tilt v]))))])

(defn- after-commit!
  "Run `f` once React has put its tree in the document.

  `setTimeout 0` is not that. React 18's scheduler and the timer queue are
  different queues, and which runs first has been observed to vary: the
  globe sometimes started on the SERVER-rendered canvas, which React then
  replaced, leaving the renderer drawing into a detached node. A double
  `requestAnimationFrame` lands after the commit and before the paint."
  [f]
  (js/requestAnimationFrame (fn [] (js/requestAnimationFrame f))))

(defn ^:dev/after-load mount! []
  (let [el (.getElementById js/document "app")]
    (when-not @root (reset! root (rdc/create-root el)))
    (rdc/render @root [ui])
    (after-commit! start-globe!)))

(defn init []
  (rf/dispatch-sync [::events/init])
  (route/listen! (fn [v]
                   (rf/dispatch [::events/set-view (:id v)])
                   (after-commit! start-globe!)))
  (rf/dispatch [::events/load-basemap])
  (rf/dispatch [::events/load-buildings])
  (rf/dispatch [::events/load-all])
  (rf/dispatch [::events/load-weather])
  (mount!))
